HOST=0.0.0.0
PORT=3000

DATABASE_PATH=./data/clearmacro-provider.sqlite

REGISTRY_PATH=config/registry.json

# Must match `payload.security.provider` from dapps (see GET /v1/capabilities).
PROVIDER_NAME=macros.superfluid.eth

OZ_RELAYER_VERSION=v1.4.0
OZ_RELAYER_URL=http://localhost:8080
OZ_RELAYER_PORT=8080
OZ_RELAYER_METRICS_PORT=8081
OZ_RELAYER_API_KEY=change-me-32-byte-minimum-api-key
OZ_WEBHOOK_SIGNING_KEY=change-me-webhook-signing-key
OZ_STORAGE_ENCRYPTION_KEY=change-me-base64-32-byte-key
OZ_KEYSTORE_PASSPHRASE=change-me
OZ_REPOSITORY_STORAGE_TYPE=redis
OZ_RESET_STORAGE_ON_START=false
OZ_LOG_LEVEL=info

RUN_MIGRATIONS_ON_START=true
RELAYER_WORKER_ENABLED=true
RELAYER_WORKER_POLL_INTERVAL_MS=2000
API_AUTH_ENABLED=false
# When API_AUTH_ENABLED=true, set a JSON array of { "id": string, "apiTokenHash": string } where apiTokenHash is sha256(hex) of the bearer token.
# API_CLIENTS_JSON=[{"id":"my-dapp","apiTokenHash":"..."}]

LOG_LEVEL=info

ANVIL_PORT=8545
